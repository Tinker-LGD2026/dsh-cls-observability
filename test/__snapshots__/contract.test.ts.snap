// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`span tree snapshots > acp/cancel-tool-calls/session.v4.jsonl 1`] = `
"entry enter_application  [trigger=user end=aborted]
  agent invoke_agent main
    step react round_1
      chat chat deepseek-v4-flash  [finish=["tool_calls"] out=10]
      tool execute_tool bash  [ERROR(ABORTED)]
      tool execute_tool bash  [ERROR(ABORTED_BEFORE_DISPATCH)]"
`;

